<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{9A359B56-2B76-41D8-A249-88F924F53B69}</ProjectGuid>
    <MainSource>Devbox.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Application</AppType>
    <FrameworkType>VCL</FrameworkType>
    <ProjectVersion>19.2</ProjectVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
    <Base_Win32>true</Base_Win32>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
    <Base_Win64>true</Base_Win64>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
      <DCC_MapFile>3</DCC_MapFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <PreBuildEvent>powershell -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)..\tools\google-client.ps1" -Out "$(ProjectDir)..\dcu\gen\Devbox.GoogleClient.inc"</PreBuildEvent>
    <CUI Condition="'$(CUI)'==''">..\..\Delphi\ComponentesUI</CUI>
    <DCC_CodePage>65001</DCC_CodePage>
    <SanitizedProjectName>Devbox</SanitizedProjectName>
    <DCC_Namespace>Vcl;Vcl.Imaging;Winapi;System.Win;Data.Win;System;Data;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>..\dcu\gen;$(CUI)\src;$(CUI)\src\core;$(CUI)\src\components\basic;$(CUI)\src\components\feedback;$(CUI)\src\components\layout;$(CUI)\src\components\data;$(CUI)\src\components\form;$(CUI)\src\components\display;$(CUI)\src\components\overlay;$(CUI)\src\components\nav;$(CUI)\src\components\report;$(CUI)\src\components\assistant;$(CUI)\thirdpart\skia4delphi\Source;$(CUI)\thirdpart\skia4delphi\Source\VCL;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_DcuOutput>..\dcu\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_ExeOutput>..\bin\$(Platform)\$(Config)</DCC_ExeOutput>
    <Manifest_File>$(BDS)\bin\default_app.manifest</Manifest_File>
    <AppDPIAwarenessMode>PerMonitorV2</AppDPIAwarenessMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base_Win32)'!=''">
    <PostBuildEvent>copy /Y "$(CUI)\tests\bin\Win32\Debug\sk4d.dll" "$(ProjectDir)..\bin\Win32\$(Config)\"&amp;&amp; copy /Y "$(ProjectDir)ocr.ps1" "$(ProjectDir)..\bin\Win32\$(Config)\"</PostBuildEvent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base_Win64)'!=''">
    <PostBuildEvent>copy /Y "$(CUI)\tests\bin\Win64\Debug\sk4d.dll" "$(ProjectDir)..\bin\Win64\$(Config)\"&amp;&amp; copy /Y "$(ProjectDir)ocr.ps1" "$(ProjectDir)..\bin\Win64\$(Config)\"&amp;&amp; xcopy /Y /I /Q "$(ProjectDir)..\assets\assistant\*.json" "$(ProjectDir)..\bin\Win64\$(Config)\assets\assistant\"</PostBuildEvent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
    <Cfg_2>true</Cfg_2>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
    <DCC_Optimize>true</DCC_Optimize>
    <DCC_DebugInformation>0</DCC_DebugInformation>
    <DCC_AssertionsAtRuntime>false</DCC_AssertionsAtRuntime>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
